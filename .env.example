# Telegram Bot API token obtained from @BotFather
TG_TOKEN=your_telegram_bot_token_here

# Numeric Telegram User ID allowed to interact with the bot (e.g. from @userinfobot)
TG_USER_ID=123456789

# Google Sheets Spreadsheet ID (from spreadsheet URL between /d/ and /edit)
GOOGLE_SHEET_ID=your_google_spreadsheet_id_here

# Google Gemini API key obtained from Google AI Studio
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model identifier used for text and voice message parsing
GEMINI_MODEL=gemini-2.5-flash
